# Orchestrator backend (Express health API)
# Local dev default; set to your Railway URL in production.
NEXT_PUBLIC_ORCHESTRATOR_URL=http://localhost:3001

# Auth token for mutating orchestrator endpoints (trigger, agent toggles, etc.)
# Must match the AUTH_TOKEN in orchestrator/.env
NEXT_PUBLIC_ORCHESTRATOR_TOKEN=your_auth_token_here

# WalletConnect / Reown Project ID (get one free at https://cloud.reown.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Optional Coston2 deployment. Leave blank until `npm run deploy:flare` succeeds.
NEXT_PUBLIC_FLARE_FTSO_ADAPTER_ADDRESS=
NEXT_PUBLIC_FXRP_TREASURY_GUARD_ADDRESS=
