{
  "name": "sovereignmind-orchestrator",
  "version": "1.0.0",
  "description": "SovereignMind Agent Orchestration Backend — Automates decision cycles on Somnia Testnet",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs'),p=require('path'),s=p.join('src','abis'),d=p.join('dist','abis');fs.mkdirSync(d,{recursive:true});fs.readdirSync(s).forEach(f=>fs.copyFileSync(p.join(s,f),p.join(d,f)));console.log('Copied ABIs to dist/abis/')\"",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "cycle": "tsx src/index.ts --once",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "ethers": "^6.16.0",
    "express": "^5.1.0",
    "node-cron": "^3.0.3",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.8"
  }
}
