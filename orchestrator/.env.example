# ============================================================
# SovereignMind Orchestrator — Environment Variables
# Copy to .env and fill in your values
# ============================================================

# Wallet private key (same deployer wallet — NEVER commit!)
PRIVATE_KEY=your_private_key_here

# Somnia Testnet RPC
RPC_URL=https://dream-rpc.somnia.network

# Contract Addresses (from deployed-addresses.json — deployed 2026-06-01)
AGENT_REGISTRY_ADDRESS=0x41A6a0c76ddAD6F5dAeC70F7aaFA439eba1AC0c3
TREASURY_VAULT_ADDRESS=0x8f1c9bd9cc0EF059D0175fF05153D2fEe8Be7f9d
CEO_AGENT_ADDRESS=0xd58a92F4BF829921a6cdc6FeE54d7CC8743F75c9
CFO_AGENT_ADDRESS=0xEE3dB72FBBF25248edDe8324670aC8F1b9285869
CMO_AGENT_ADDRESS=0x9C13A3d3ca1BB420F6f2489c93785eCE3125c600
AGENT_RUNNER_ADDRESS=0x037Bb9C718F3f7fe5eCBDB0b600D607b52706776

# Orchestration Config
CYCLE_INTERVAL_MINUTES=15
MIN_AGENT_BALANCE_STT=0.05
AUTO_FUND_AMOUNT_STT=0.1
EVENT_TIMEOUT_SECONDS=120

# Tokens to track via CoinGecko
TRACKED_TOKENS=bitcoin,ethereum,solana

# Market scan URL (Somnia-focused for hackathon)
MARKET_SCAN_URL=https://www.coingecko.com/en/coins/somnia

# Health API
HEALTH_PORT=3001
