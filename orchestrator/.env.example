# ============================================================
# SovereignMind Orchestrator — Environment Variables
# Copy to .env and fill in your values
# ============================================================

# Wallet private key (same deployer wallet — NEVER commit!)
PRIVATE_KEY=your_private_key_here

# Somnia Testnet RPC
RPC_URL=https://dream-rpc.somnia.network

# Contract Addresses (v3 — redeployed with correct Somnia callback types)
AGENT_REGISTRY_ADDRESS=0xc7aaa0fbef5660E2AF3592a4D80F278f48e989a2
TREASURY_VAULT_ADDRESS=0x67f363ef90FC2f1C4AFD530f18C706d9A0012497
CEO_AGENT_ADDRESS=0x22CbB6f3ef01478b68846291390D91C2eEE92e0B
CFO_AGENT_ADDRESS=0xCa324fC74A3D8C52D9128BC158ef62a6004fa7De
CMO_AGENT_ADDRESS=0x80Ac28fc43899dB56a5db28b3767fd5Bf61BdECB
AGENT_RUNNER_ADDRESS=0x037Bb9C718F3f7fe5eCBDB0b600D607b52706776

# v4 Synthetic Portfolio (optional — leave empty to skip portfolio rebalance)
VAULT_SHARES_ADDRESS=0x2029d8E6333A43E17d400b4f8EDF4694Af79aEe6
SWAP_ROUTER_ADDRESS=0x4c92c0EdF00a95702a1268DC01196b7f7144405d
PRICE_ORACLE_ADDRESS=0xc01BDABB279dCBf89F093b8efB4294E10763B119

# Orchestration Config
CYCLE_INTERVAL_MINUTES=15
MIN_AGENT_BALANCE_STT=0.05
AUTO_FUND_AMOUNT_STT=0.1
EVENT_TIMEOUT_SECONDS=120

# Tokens to track via CoinGecko
TRACKED_TOKENS=bitcoin,ethereum,solana

# Market scan URL (Somnia-focused for hackathon)
MARKET_SCAN_URL=https://www.coingecko.com/en/coins/somnia

# Health API
HEALTH_PORT=3001

# Auth token for /trigger, /stop, /resume (REQUIRED in production)
# Generate: openssl rand -hex 32
AUTH_TOKEN=your_secure_random_token_here
