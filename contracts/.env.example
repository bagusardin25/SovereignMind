# SovereignMind Contracts — Environment Variables
# Copy to .env and fill in your values

# Deployer wallet private key (NEVER commit this!)
PRIVATE_KEY=your_wallet_private_key_here

# Somnia Testnet RPC
SOMNIA_RPC_URL=https://dream-rpc.somnia.network

# Agent Runner Contract Address (check https://agents.testnet.somnia.network/)
AGENT_RUNNER_ADDRESS=0x_agent_runner_contract_address

# Somnia Agent IDs (check Agent Explorer for current IDs)
JSON_API_AGENT_ID=1
LLM_INFERENCE_AGENT_ID=2
LLM_PARSE_WEBSITE_AGENT_ID=3
