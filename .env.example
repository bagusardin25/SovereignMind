# SovereignMind Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================================
# Somnia Testnet Configuration
# ============================================================
NEXT_PUBLIC_SOMNIA_RPC_URL=https://dream-rpc.somnia.network
NEXT_PUBLIC_SOMNIA_CHAIN_ID=50312
NEXT_PUBLIC_SOMNIA_CHAIN_NAME=Somnia Testnet
NEXT_PUBLIC_SOMNIA_CURRENCY_SYMBOL=STT
NEXT_PUBLIC_SOMNIA_BLOCK_EXPLORER=https://shannon.somnia.network

# ============================================================
# Contract Addresses (Update after deployment)
# ============================================================
NEXT_PUBLIC_AGENT_REGISTRY_ADDRESS=
NEXT_PUBLIC_TREASURY_VAULT_ADDRESS=
NEXT_PUBLIC_CEO_AGENT_ADDRESS=
NEXT_PUBLIC_CFO_AGENT_ADDRESS=
NEXT_PUBLIC_CMO_AGENT_ADDRESS=

# ============================================================
# Somnia Receipts API
# ============================================================
NEXT_PUBLIC_SOMNIA_RECEIPTS_API=https://receipts.net.somnia.host

# ============================================================
# Optional: Analytics & Monitoring
# ============================================================
# NEXT_PUBLIC_GA_TRACKING_ID=
# NEXT_PUBLIC_SENTRY_DSN=

# ============================================================
# Development Settings
# ============================================================
# Set to 'true' to use mock data instead of live contracts
NEXT_PUBLIC_USE_MOCK_DATA=true
